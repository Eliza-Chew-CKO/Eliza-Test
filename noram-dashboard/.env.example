# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── BigQuery ────────────────────────────────────────────────────────────────
# GCP project that owns the BigQuery dataset
BQ_PROJECT_ID=your-gcp-project-id

# BigQuery dataset name (all tables must live in the same dataset)
BQ_DATASET=noram

# BigQuery multi-region location
BQ_LOCATION=US

# Table names (override if your dataset uses different names)
BQ_TABLE_FINANCIALS=financial_actuals
BQ_TABLE_TPV=tpv_actuals
BQ_TABLE_PIPELINE_SNAPSHOTS=pipeline_snapshots
BQ_TABLE_OPPORTUNITIES=opportunities
BQ_TABLE_VAMP=vamp_records
BQ_TABLE_TARGETS=targets
BQ_TABLE_AM_TARGETS=am_targets
BQ_TABLE_ACCOUNTS=accounts

# ─── Authentication ──────────────────────────────────────────────────────────
# Option A — Local development: point to a GCP service account key JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Option B — ECS Fargate (WIF): paste the Workload Identity Federation
# credential configuration JSON as a single-line string.
# Generate it from GCP console:
#   IAM → Workload Identity Pools → your pool → Download configuration
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"external_account","audience":"..."}

# ─── ECS Fargate WIF token refresh ───────────────────────────────────────────
# How often (ms) to refresh Fargate AWS credentials before exchanging for GCP tokens.
# Default: 5400000 (90 minutes). Must be less than the AWS session token expiry.
# CREDENTIAL_REFRESH_INTERVAL_MS=5400000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Set in apps/web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:4000
