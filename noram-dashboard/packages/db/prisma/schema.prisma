generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   // SALES_REP | ACCOUNT_MANAGER | REVENUE_OPS | EXECUTIVE
  salesRegion String
  createdAt   DateTime @default(now())

  // A user can own many accounts as the primary sales rep
  accounts         Account[]     @relation("SalesRep")
  // A user can manage many accounts as the designated account manager
  managedAccounts  Account[]     @relation("AccountManager")
  // A user can be the primary rep on many opportunities
  opportunities    Opportunity[] @relation("PrimaryRep")
}

// ─── Account ─────────────────────────────────────────────────────────────────

model Account {
  id               String    @id @default(cuid())
  alias            String    @unique
  tier             String    // Enterprise | Mid-Market | SMB
  isManaged        Boolean   @default(false)
  salesRepId       String
  accountManagerId String?
  goLiveDate       DateTime?
  region           String
  referralPartner  String?
  sector           String?
  createdAt        DateTime  @default(now())

  salesRep       User              @relation("SalesRep", fields: [salesRepId], references: [id])
  accountManager User?             @relation("AccountManager", fields: [accountManagerId], references: [id])
  opportunities  Opportunity[]
  financials     FinancialActual[]
  vampRecords    VampRecord[]
}

// ─── Opportunity ──────────────────────────────────────────────────────────────

model Opportunity {
  id                  String    @id @default(cuid())
  accountId           String
  salesRepId          String
  stage               String    // Discovery | Scoping | Proposal | Negotiation | Closed Won | Closed Lost
  type                String    // New Logo | Expansion | Renewal
  baseMonthlyRevenue  Decimal   @db.Decimal(18, 2)
  rollMonthlyRevenue  Decimal   @db.Decimal(18, 2)
  weightedExpectedMNR Decimal   @db.Decimal(18, 2)
  closeDate           DateTime
  goLiveDate          DateTime?
  rating              String?   // A | B | C | null
  secondOwnerId       String?
  stageHistory        Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  account  Account @relation(fields: [accountId], references: [id])
  salesRep User    @relation("PrimaryRep", fields: [salesRepId], references: [id])
}

// ─── FinancialActual ──────────────────────────────────────────────────────────

model FinancialActual {
  id             String   @id @default(cuid())
  accountId      String
  reportingMonth DateTime // always first day of the month
  totalFees      Decimal  @db.Decimal(18, 2)
  grossFX        Decimal  @default(0) @db.Decimal(18, 2)
  ccpExclusion   Decimal  @default(0) @db.Decimal(18, 2)
  netRevenue     Decimal  @db.Decimal(18, 2)
  tpvAmount      Decimal  @default(0) @db.Decimal(18, 2)
  binType        String?  // null for main DATA rows, e.g. "VISA_CREDIT" for BIN TPV rows
  acquirerId     String?
  createdAt      DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, reportingMonth, binType, acquirerId])
}

// ─── Target ───────────────────────────────────────────────────────────────────

enum TargetType {
  FRONTBOOK_BASE
  FRONTBOOK_ROLL
  BACKBOOK_MANAGED
  BACKBOOK_UNMANAGED
  TPV
}

model Target {
  id          String     @id @default(cuid())
  period      String     // "YYYY-MM"
  type        TargetType
  amount      Decimal    @db.Decimal(18, 2)
  goLiveCount Int?       // used for FRONTBOOK_BASE targets
  createdAt   DateTime   @default(now())

  @@unique([period, type])
}

// ─── VampRecord ───────────────────────────────────────────────────────────────

model VampRecord {
  id                  String   @id @default(cuid())
  accountId           String
  reportingMonth      DateTime // always first day of the month
  createdEvents       Int
  fraudEvents         Int
  totalCapturedEvents Int
  vampRatio           Decimal  @db.Decimal(10, 6)
  vampType            String   // NORMAL | EXCESSIVE
  vampAssessment      String?  // free-text or dollar amount of assessment charge
  acquirerCountry     String?
  acquirerId          String?
  createdAt           DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, reportingMonth, acquirerId])
}
