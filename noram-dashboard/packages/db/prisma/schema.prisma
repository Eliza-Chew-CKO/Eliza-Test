generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         UserRole
  salesRegion  String?
  createdAt    DateTime @default(now())

  accountsAsRep      Account[]      @relation("SalesRep")
  accountsAsAM       Account[]      @relation("AccountManager")
  opportunitiesAsRep Opportunity[]  @relation("OpportunitySalesRep")
  opportunitiesAs2nd Opportunity[]  @relation("OpportunitySecondOwner")
}

enum UserRole {
  SALES_REP
  ACCOUNT_MANAGER
  REVENUE_OPS
  EXECUTIVE
}

model Account {
  id               String    @id @default(cuid())
  alias            String    @unique
  tier             Tier
  isManaged        Boolean   @default(false)
  salesRepId       String?
  accountManagerId String?
  goLiveDate       DateTime?
  region           String?
  referralPartner  String?
  sector           String?
  createdAt        DateTime  @default(now())

  salesRep       User?           @relation("SalesRep", fields: [salesRepId], references: [id])
  accountManager User?           @relation("AccountManager", fields: [accountManagerId], references: [id])
  opportunities  Opportunity[]
  financials     FinancialActual[]
  vampRecords    VampRecord[]
}

enum Tier {
  TIER_1
  TIER_2
  TIER_3
}

model Opportunity {
  id                   String           @id @default(cuid())
  accountId            String
  salesRepId           String?
  secondOwnerId        String?
  stage                OpportunityStage
  type                 OpportunityType  @default(NEW_BUSINESS)
  baseMonthlyRevenue   Decimal?         @db.Decimal(18, 2)
  rollMonthlyRevenue   Decimal?         @db.Decimal(18, 2)
  weightedExpectedMNR  Decimal?         @db.Decimal(18, 2)
  closeDate            DateTime?
  goLiveDate           DateTime?
  rating               String?
  stageHistory         Json             @default("[]")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  account     Account @relation(fields: [accountId], references: [id])
  salesRep    User?   @relation("OpportunitySalesRep", fields: [salesRepId], references: [id])
  secondOwner User?   @relation("OpportunitySecondOwner", fields: [secondOwnerId], references: [id])
}

enum OpportunityStage {
  EXPLORE
  PROPOSE
  TRADE
  HANDOVER
  LIVE
  CLOSED_WON
  DISQUALIFIED
  TERMINATED
}

enum OpportunityType {
  NEW_BUSINESS
  EXPANSION
  RENEWAL
}

model FinancialActual {
  id               String   @id @default(cuid())
  accountId        String
  reportingMonth   DateTime
  totalFees        Decimal  @db.Decimal(18, 2)
  grossFX          Decimal  @default(0) @db.Decimal(18, 2)
  ccpExclusion     Decimal  @default(0) @db.Decimal(18, 2)
  netRevenue       Decimal  @db.Decimal(18, 2)
  tpvAmount        Decimal  @default(0) @db.Decimal(18, 2)
  binType          String?
  acquirerId       String?
  createdAt        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, reportingMonth, binType])
}

model Target {
  id           String     @id @default(cuid())
  period       DateTime
  type         TargetType
  amount       Decimal    @db.Decimal(18, 2)
  goLiveCount  Int?
  createdAt    DateTime   @default(now())

  @@unique([period, type])
}

enum TargetType {
  FRONTBOOK_BASE
  FRONTBOOK_ROLL
  BACKBOOK_MANAGED
  BACKBOOK_UNMANAGED
  TPV
  GO_LIVE_COUNT
}

model VampRecord {
  id                  String   @id @default(cuid())
  accountId           String
  reportingMonth      DateTime
  createdEvents       Int
  fraudEvents         Int
  totalCapturedEvents Int
  vampRatio           Decimal  @db.Decimal(10, 6)
  vampType            VampType @default(NORMAL)
  vampAssessment      Decimal? @db.Decimal(18, 2)
  acquirerCountry     String?
  acquirerId          String?
  createdAt           DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, reportingMonth])
}

enum VampType {
  NORMAL
  EXCESSIVE
}
