// Prisma schema for NORAM Sales Dashboard
// Run: npx prisma migrate dev --name init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TargetType {
  FRONTBOOK_BASE
  FRONTBOOK_ROLL
  BACKBOOK_MANAGED
  BACKBOOK_UNMANAGED
  TPV
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   // e.g. "AE", "AM", "Manager"
  salesRegion String   // e.g. "US-East", "Canada"
  createdAt   DateTime @default(now())

  // A user can be the primary sales rep on many accounts
  accounts         Account[]     @relation("SalesRep")
  // A user can be the account manager on many accounts
  managedAccounts  Account[]     @relation("AccountManager")
  // A user can own many opportunities as primary rep
  opportunities    Opportunity[] @relation("PrimaryRep")
}

model Account {
  id               String    @id @default(cuid())
  alias            String
  tier             String    // "Enterprise" | "Mid-Market" | "SMB"
  isManaged        Boolean   @default(false)

  salesRepId       String
  salesRep         User      @relation("SalesRep", fields: [salesRepId], references: [id])

  accountManagerId String?
  accountManager   User?     @relation("AccountManager", fields: [accountManagerId], references: [id])

  goLiveDate       DateTime?
  region           String    // e.g. "US-East", "Canada"
  referralPartner  String?
  sector           String?   // e.g. "FinTech", "eCommerce"
  createdAt        DateTime  @default(now())

  financials       FinancialActual[]
  vampRecords      VampRecord[]
  opportunities    Opportunity[]
}

model Opportunity {
  id                  String    @id @default(cuid())
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id])

  salesRepId          String
  salesRep            User      @relation("PrimaryRep", fields: [salesRepId], references: [id])

  stage               String    // "Discovery"|"Scoping"|"Proposal"|"Negotiation"|"Closed Won"|"Closed Lost"
  type                String    // "New Logo"|"Expansion"|"Renewal"

  baseMonthlyRevenue  Decimal   @db.Decimal(14, 2)
  rollMonthlyRevenue  Decimal   @db.Decimal(14, 2)
  weightedExpectedMNR Decimal   @db.Decimal(14, 2)

  closeDate           DateTime
  goLiveDate          DateTime?
  rating              String?   // "Hot"|"Warm"|"Cold"
  secondOwnerId       String?   // co-owner rep ID (non-relational for simplicity)

  // Full stage transition history stored as JSON array of { stage, enteredAt, exitedAt }
  stageHistory        Json      @default("[]")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model FinancialActual {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])

  reportingMonth DateTime // always first day of the month (e.g. 2025-06-01)
  totalFees      Decimal  @db.Decimal(14, 2)
  grossFX        Decimal  @db.Decimal(14, 2)
  ccpExclusion   Decimal  @db.Decimal(14, 2)
  netRevenue     Decimal  @db.Decimal(14, 2)
  tpvAmount      Decimal  @db.Decimal(18, 2)

  binType        String?  // BIN category code
  acquirerId     String?  // acquirer identifier from BIN TPV sheet

  createdAt      DateTime @default(now())

  // A given account + month + BIN type + acquirer combination must be unique
  @@unique([accountId, reportingMonth, binType, acquirerId])
}

model Target {
  id          String     @id @default(cuid())
  period      String     // "YYYY-MM" e.g. "2025-06"
  type        TargetType
  amount      Decimal    @db.Decimal(14, 2)
  goLiveCount Int?       // target number of go-lives (only relevant for FRONTBOOK_BASE)
  createdAt   DateTime   @default(now())

  // Only one target per period + type combination
  @@unique([period, type])
}

model VampRecord {
  id                  String   @id @default(cuid())
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id])

  reportingMonth      DateTime
  createdEvents       Int
  fraudEvents         Int
  totalCapturedEvents Int
  vampRatio           Decimal  @db.Decimal(10, 6)

  vampType            String   // e.g. "VISA_VAMP", "MC_MATCH"
  vampAssessment      String?  // "Healthy"|"At Risk"|"Excessive"

  acquirerCountry     String?
  acquirerId          String?

  createdAt           DateTime @default(now())

  // One VAMP record per account + month + acquirer combination
  @@unique([accountId, reportingMonth, acquirerId])
}
