// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TargetType {
  FRONTBOOK_BASE
  FRONTBOOK_ROLL
  BACKBOOK_MANAGED
  BACKBOOK_UNMANAGED
  TPV
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// Sales reps, account managers, and other team members.
model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  /// e.g. "AE" | "AM" | "Manager" | "Admin"
  role        String
  salesRegion String
  createdAt   DateTime @default(now())

  // Relations — a user can be the primary sales rep on many accounts
  accounts        Account[] @relation("SalesRep")
  // A user can be the account manager (AM) on many accounts
  managedAccounts Account[] @relation("AccountManager")
  // A user can be the primary rep on many opportunities
  opportunities   Opportunity[] @relation("PrimaryRep")
}

/// A merchant / customer account.
model Account {
  id               String    @id @default(cuid())
  /// Display name used in all reporting (may differ from legal entity name)
  alias            String
  /// "Enterprise" | "Mid-Market" | "SMB"
  tier             String
  /// Whether the account has a dedicated Account Manager
  isManaged        Boolean   @default(false)
  salesRepId       String
  salesRep         User      @relation("SalesRep", fields: [salesRepId], references: [id])
  accountManagerId String?
  accountManager   User?     @relation("AccountManager", fields: [accountManagerId], references: [id])
  goLiveDate       DateTime?
  region           String
  referralPartner  String?
  sector           String?
  createdAt        DateTime  @default(now())

  // Relations
  financials   FinancialActual[]
  vampRecords  VampRecord[]
  opportunities Opportunity[]
}

/// A sales opportunity (sourced from Salesforce).
model Opportunity {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  salesRepId  String
  salesRep    User      @relation("PrimaryRep", fields: [salesRepId], references: [id])
  /// Pipeline stage: Discovery | Scoping | Proposal | Negotiation | Closed Won | Closed Lost
  stage       String
  /// Deal type: "New Logo" | "Expansion" | "Renewal"
  type        String
  /// Committed monthly revenue at go-live (base, no ramp)
  baseMonthlyRevenue    Decimal
  /// Expected monthly revenue after ramp (roll rate)
  rollMonthlyRevenue    Decimal
  /// baseMonthlyRevenue × stage probability weighting
  weightedExpectedMNR   Decimal
  closeDate   DateTime
  goLiveDate  DateTime?
  rating      String?
  /// Second owner / overlay rep on the deal
  secondOwnerId String?
  /// JSON array of { stage, enteredAt, exitedAt } objects
  stageHistory  Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Monthly financial actuals per account, keyed by reporting month.
/// Supports multiple rows per account/month when data is split by BIN type and acquirer.
model FinancialActual {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  /// First day of the reporting month (e.g. 2025-06-01 00:00:00 UTC)
  reportingMonth DateTime
  totalFees      Decimal
  grossFX        Decimal
  ccpExclusion   Decimal
  netRevenue     Decimal
  tpvAmount      Decimal
  /// BIN classification (e.g. "DEBIT" | "CREDIT" | "PREPAID")
  binType        String?
  /// Acquirer identifier (e.g. "ACQ_VISA_US")
  acquirerId     String?
  createdAt      DateTime @default(now())

  @@unique([accountId, reportingMonth, binType, acquirerId])
}

/// Monthly revenue and volume targets.
model Target {
  id          String     @id @default(cuid())
  /// Format: "YYYY-MM" (e.g. "2025-06")
  period      String
  type        TargetType
  amount      Decimal
  /// Target number of accounts to go live (only relevant for FRONTBOOK_BASE)
  goLiveCount Int?
  createdAt   DateTime   @default(now())

  @@unique([period, type])
}

/// Visa Acquirer Monitoring Programme fraud records per account per month.
/// Multiple rows per account/month are possible when data is broken out by acquirer.
model VampRecord {
  id                   String   @id @default(cuid())
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id])
  reportingMonth       DateTime
  createdEvents        Int
  fraudEvents          Int
  totalCapturedEvents  Int
  /// vampRatio = fraudEvents / totalCapturedEvents
  vampRatio            Decimal
  /// Source classification from the acquirer report
  vampType             String
  /// Internal assessment: "Under review" | "Actioned" | "Monitoring" | null
  vampAssessment       String?
  acquirerCountry      String?
  acquirerId           String?
  createdAt            DateTime @default(now())

  @@unique([accountId, reportingMonth, acquirerId])
}
